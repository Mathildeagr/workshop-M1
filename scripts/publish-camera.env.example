# Copier en scripts/publish-camera.env (ignoré par git) et adapter.

# Caméra locale : index renvoyé par ./publish-camera.sh --list
CAMERA_INDEX=0
VIDEO_SIZE=1280x720
FRAMERATE=25
BITRATE=2M

# Récepteur (mediamtx)
TARGET_HOST=127.0.0.1
TARGET_PORT=8554
STREAM_PATH=sentinel

# Authentification de publication mediamtx.
# Inutile et à laisser vide si SSH_TUNNEL=1.
RTSP_USER=
RTSP_PASS=

# Poste à poste : flux chiffré, aucun port RTSP exposé sur le réseau.
SSH_TUNNEL=0
SSH_TARGET=
