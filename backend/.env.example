PORT=3000
DATABASE_URL=postgres://sentinel:CHANGE_ME@localhost:5432/sentinel

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_au_moins_32_caracteres
JWT_EXPIRES_IN=8h

# Origines autorisées (dashboard), séparées par des virgules
CORS_ORIGINS=http://localhost:4200

# Une clé par appareil, format id:cle (cle >= 32 caractères), séparées par des virgules
# L'id devient la "source" des alertes envoyées avec cette clé
DEVICE_API_KEYS=esp01:CHANGE_ME_cle_esp_32_caracteres_min,vision:CHANGE_ME_cle_vision_32_caracteres,predictive:CHANGE_ME_cle_predictive_32_caracteres

# Premier compte admin, créé au démarrage s'il n'existe aucun admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_12_caracteres_min

# Nombre de proxys devant l'API : 0 en local, 1 derrière Traefik (déjà défini dans compose.yml)
TRUST_PROXY=0

# Compte MQTT du backend : le même que dans mosquitto/config/passwd (voir README)
MQTT_USERNAME=backend
MQTT_PASSWORD=CHANGE_ME

# Service vision ai-vision/server.py (dev local ; sous Docker, défini dans le .env racine)
VISION_SERVICE_URL=http://127.0.0.1:5000
VISION_SERVICE_TOKEN=CHANGE_ME_meme_valeur_que_SENTINEL_SERVICE_TOKEN
