# Copier en .env pour un lancement hors Docker. Sous Docker, ces valeurs sont
# fournies par compose.yml et le .env de la racine.

DATABASE_URL=postgres://sentinel:CHANGE_ME@localhost:5432/sentinelx

# Compte MQTT de la brique : a creer dans mosquitto/config/passwd (voir le README racine)
PREDICT_MQTT_HOST=localhost
PREDICT_MQTT_PORT=1883
PREDICT_MQTT_USER=predictive
PREDICT_MQTT_PASSWORD=CHANGE_ME

# Sortie HTTP de secours, tant que le backend n'a pas d'abonne MQTT.
# Laisser vide pour la desactiver. Le jeton est la cle "predictive" de DEVICE_API_KEYS.
SENTINEL_API_URL=http://localhost:3000/api/v1/alerts
SENTINEL_API_TOKEN=CHANGE_ME_cle_predictive_32_caracteres

# Reglages de depart. Le backend les change ensuite par le bus.
PREDICT_SENSITIVITY=medium
PREDICT_WINDOW_DAYS=7

PREDICT_MODEL_DIR=./var
