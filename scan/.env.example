# Copier en scan/.env et remplacer les valeurs

# Clé de l'appareil "scan" : même valeur que scan:<cle> dans DEVICE_API_KEYS (backend/.env)
SENTINEL_SCAN_API_KEY=CHANGE_ME_cle_scan_32_caracteres_min

# API via Traefik (défaut : https://localhost/api/v1/alerts)
# SENTINEL_SCAN_API_URL=https://localhost/api/v1/alerts

# Certificat de l'autorité à faire confiance (vérification TLS)
# SENTINEL_CA_CERT=../certs/sentinel.localhost.crt

# Local uniquement : ne vérifie pas le certificat auto-signé de Traefik
# SENTINEL_SCAN_INSECURE_TLS=1
