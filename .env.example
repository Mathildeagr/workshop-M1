# Variables lues par compose.yml : copier ce fichier en .env (à la racine) et remplacer les valeurs
# Les secrets de l'API (JWT, clés appareils, admin) sont dans backend/.env (voir backend/.env.example)

POSTGRES_USER=sentinel
# Lettres et chiffres uniquement : il est inséré tel quel dans l'URL de connexion du backend
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinelx

# Port HTTP exposé par Traefik sur la machine (80 par défaut)
# HTTP_PORT=8000

# Service vision en conteneur (profil "vision", hôte Linux uniquement)
# Jeton partagé backend <-> service vision, 32 caractères min
# VISION_SERVICE_TOKEN=CHANGE_ME_32_caracteres_minimum_xx
# Clé "vision" de DEVICE_API_KEYS (backend/.env)
# VISION_API_KEY=CHANGE_ME_cle_vision_32_caracteres
