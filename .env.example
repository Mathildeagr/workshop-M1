# Variables lues par compose.yml : copier ce fichier en .env (à la racine) et remplacer les valeurs
# Les secrets de l'API (JWT, clés appareils, admin) sont dans backend/.env (voir backend/.env.example)

POSTGRES_USER=sentinel
# Lettres et chiffres uniquement : il est inséré tel quel dans l'URL de connexion du backend
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinelx

# Port HTTP exposé par Traefik sur la machine (80 par défaut)
# HTTP_PORT=8000

# Service vision (ai-vision/server.py)
# Jeton partagé backend <-> service vision, 32 caractères min : même valeur que SENTINEL_SERVICE_TOKEN
# dans ai-vision/.env quand le service tourne sur l'hôte
VISION_SERVICE_TOKEN=CHANGE_ME_32_caracteres_minimum_xx
# Adresse du service vu depuis le conteneur backend (défaut : http://host.docker.internal:5000,
# mettre http://ai-vision:5000 avec le profil "vision")
# VISION_SERVICE_URL=http://ai-vision:5000
# Profil "vision" uniquement (hôte Linux) : clé "vision" de DEVICE_API_KEYS (backend/.env)
# VISION_API_KEY=CHANGE_ME_cle_vision_32_caracteres

# Brique predict-anomalie
# Compte MQTT : même mot de passe que dans mosquitto/config/passwd (voir README)
PREDICT_MQTT_USER=predictive
PREDICT_MQTT_PASSWORD=CHANGE_ME
# Clé "predictive" de DEVICE_API_KEYS (backend/.env). Vide = pas de sortie HTTP.
PREDICT_API_KEY=CHANGE_ME_cle_predictive_32_caracteres
