# Copier ce fichier en .env et remplacer par tes valeurs
# Le vrai .env n'est pas versionné et peut contenir des valeurs locales ou sensibles

SENTINEL_CAMERA=0
SENTINEL_CAMERA_BACKEND=auto
SENTINEL_CAMERA_MJPG=0
SENTINEL_FACES_DB=./data/faces.json
SENTINEL_SNAPSHOTS_DIR=./data/snapshots
SENTINEL_USE_YOLO=1
SENTINEL_YOLO_MODEL=yolov8n.pt
SENTINEL_YOLO_DEVICE=auto

# Alertes vers le backend, via Traefik en HTTPS (pas le port du service vision)
SENTINEL_API_URL=https://localhost/api/v1/alerts
# Clé "vision" de DEVICE_API_KEYS (backend/.env) ; écrite par scripts/generate-secrets.py
SENTINEL_API_TOKEN=CHANGE_ME_cle_vision_32_caracteres_min
# Certificat généré par init.sh (chemin relatif au dossier ai-vision) : sans lui, aucune alerte ne part
SENTINEL_CA_CERT=../certs/sentinel.crt
SENTINEL_API_ENABLED=1

# server.py : jeton exigé du backend (header X-Service-Token), 32 caractères min
# Même valeur que VISION_SERVICE_TOKEN côté backend
SENTINEL_SERVICE_TOKEN=CHANGE_ME_32_caracteres_minimum
SENTINEL_SERVICE_HOST=127.0.0.1
SENTINEL_SERVICE_PORT=5000

# macOS : OpenCV demande l'autorisation camera au systeme, mais la camera est
# ouverte depuis un fil de travail et la demande ne peut s'afficher que depuis le
# fil principal — d'ou « can not spin main run loop from other thread ». On lui
# dit de ne pas la demander et de se fier a celle deja accordee.
#
# L'autorisation appartient a l'application qui lance le service, pas au script :
# demarrer server.py depuis le Terminal, qui l'a deja puisque cam_test.py
# fonctionne. Lance depuis ailleurs, la camera reste inaccessible.
OPENCV_AVFOUNDATION_SKIP_AUTH=1
