# Copier ce fichier en .env et remplacer par tes valeurs
# Le vrai .env n'est pas versionné et peut contenir des valeurs locales ou sensibles

SENTINEL_CAMERA=0
SENTINEL_CAMERA_BACKEND=auto
SENTINEL_CAMERA_MJPG=0
SENTINEL_FACES_DB=./data/faces.json
SENTINEL_SNAPSHOTS_DIR=./data/snapshots
SENTINEL_USE_YOLO=1
SENTINEL_YOLO_MODEL=yolov8n.pt
SENTINEL_YOLO_DEVICE=auto

SENTINEL_API_URL=http://127.0.0.1:5001/api/v1/alerts
SENTINEL_API_TOKEN=00ae2dfdad82d1a08c35c6fab46801f5f01079ea298421983593f0ef6152524d
SENTINEL_CA_CERT=
SENTINEL_API_ENABLED=1

# server.py : jeton exigé du backend (header X-Service-Token), 32 caractères min
# Même valeur que VISION_SERVICE_TOKEN côté backend
SENTINEL_SERVICE_TOKEN=00ae2dfdad82d1a08c35c6fab46801f5f01079ea298421983593f0ef6152524d
SENTINEL_SERVICE_HOST=127.0.0.1
SENTINEL_SERVICE_PORT=5000
